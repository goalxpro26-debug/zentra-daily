---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const heroStyle = entry.data.heroImage
  ? `background:${entry.data.heroTone};background-image:url(${entry.data.heroImage});background-size:cover;background-position:center`
  : `background:${entry.data.heroTone}`;
const initials = (name: string) => name.split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---
<Base title={entry.data.title} description={entry.data.excerpt}>
  <article class="article">
    <span class="cat-chip"><a href={`/category/${entry.data.categorySlug}/`}>{entry.data.category}</a></span>
    <h1>{entry.data.title}</h1>
    <div class="byline">
      <span class="avatar">{initials(entry.data.author)}</span>
      <span><b>{entry.data.author}</b> &nbsp;·&nbsp; {entry.data.category}</span>
      <span class="time">{entry.data.date}</span>
    </div>
    <p class="lede">{entry.data.excerpt}</p>
    <figure>
      <div class="hero-img" style={heroStyle}><span class="tag">{entry.data.heroLabel}</span></div>
      <figcaption>Illustration — not a photograph of the event. Zentra Daily does not present generated or stock illustrations as real news photographs.</figcaption>
    </figure>
    <div class="prose"><Content /></div>
    <section class="sources">
      <h2>Sources</h2>
      <ul>
        <li><a href={entry.data.sourceUrl} target="_blank" rel="noopener">{entry.data.sourceName}</a></li>
        {entry.data.sourceUrl2 && (
          <li><a href={entry.data.sourceUrl2} target="_blank" rel="noopener">{entry.data.sourceName2}</a></li>
        )}
      </ul>
      <p style="margin-top:10px;font-size:14px;color:#888">Reporting based on the sources above. Where a fact is still unconfirmed, this article says so. No quotes or figures have been invented.</p>
    </section>
    <div class="note">Zentra Daily is a human-reviewed news site. Articles are researched from credible sources and checked before publication — nothing here is auto-published.</div>
  </article>
</Base>
